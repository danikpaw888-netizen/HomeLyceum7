# Строка подключения к PostgreSQL (Neon, Supabase, Render Postgres и т.д.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Секрет для подписи JWT-токенов (замените на случайную длинную строку)
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Папка для хранения загруженных файлов
UPLOAD_DIR=uploads

# Необязательно: создать первого администратора автоматически при первом запуске
BOOTSTRAP_ADMIN_EMAIL=admin@homelyceum.local
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_NAME=Главный администратор
